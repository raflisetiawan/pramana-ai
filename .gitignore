# =============================================================
# Pramana AI — .gitignore
# =============================================================

# --- Environment ---
.env
.env.local
.env.*.local

# --- Model files (terlalu besar untuk git) ---
services/*/app/models/*.pkl
services/*/app/models/*.bin
services/*/app/models/*.pt
services/*/app/models/*.onnx
services/*/app/saved_models/
!services/*/app/saved_models/.gitkeep
!services/*/app/models/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# --- Pytest ---
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover

# --- Node / Frontend ---
node_modules/
dist/
.next/
.nuxt/
.output/

# --- Database local ---
*.db
*.sqlite
*.sqlite3

# --- Logs ---
*.log
logs/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docker ---
docker-compose.override.yml

# --- MLflow ---
mlruns/
mlartifacts/

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

.berkas